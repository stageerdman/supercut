{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Cut",
  "version": "0.1.5",
  "identifier": "xyz.supercut.editor",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run css",
    "beforeBuildCommand": "npm run css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Magic Cut",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/ffmpeg"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2ODI0NkFGNUEwMDhFM0IKUldRN2pnQmFyMGFDbHZCZ1g3NUgxNzRpUVh6NHpNOHZ5a0YzRkZyS2svbk0rRFJEdUlvMmMzRUUK",
      "endpoints": ["https://magiccut.erdman.xyz/latest.json"]
    }
  }
}
